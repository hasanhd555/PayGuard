# Copy to .env at the repository root. Never commit the populated file.
GOOGLE_API_KEY=replace-me
GROQ_API_KEY=replace-me
GENERATION_PROVIDER=groq
# Screening is fixed to gemini-decision-1 on Google's Decisions API.
TRIAGE_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b
# For Gemini text generation instead, set GENERATION_PROVIDER=google and:
# TRIAGE_MODEL=gemini-3.8-flash
# JUDGE_MODEL=gemini-3.8-flash
# Local reports only: no Logfire account or telemetry configuration required.
